# Copie este arquivo para `.env` e preencha os valores.
# O arquivo .env NUNCA vai para o Git (está no .gitignore).

# Porta da API
PORT=3333

# Endereço do front (liberado no CORS)
WEB_ORIGIN=http://localhost:5173

# Banco de dados (Postgres do docker-compose, porta 5433)
DATABASE_URL=postgresql://recipelens:recipelens@localhost:5433/recipelens

# Pasta onde ficam fotos e PDFs enviados em desenvolvimento
UPLOAD_DIR=./uploads

# IA — gere sua chave em https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo usado para ler receitas. Confira os modelos disponíveis no AI Studio.
GEMINI_MODEL=gemini-2.5-flash
