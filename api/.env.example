# Copie este arquivo para `.env` e preencha os valores.
# O arquivo .env NUNCA vai para o Git (está no .gitignore).

# Porta da API
PORT=3333

# Endereço do front (liberado no CORS)
WEB_ORIGIN=http://localhost:5173

# Banco de dados (Postgres do docker-compose, porta 5433)
DATABASE_URL=postgresql://recipelens:recipelens@localhost:5433/recipelens

# Chave secreta para assinar os tokens de login. Use um valor longo e aleatório.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Pasta onde ficam fotos e PDFs enviados em desenvolvimento
UPLOAD_DIR=./uploads

# IA — gere sua chave em https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo usado para ler receitas. Confira os modelos disponíveis no AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# Modelos reserva (separados por vírgula) para quando o principal estiver sobrecarregado
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Leituras com IA por usuário por mês (o mesmo arquivo enviado de novo não conta)
IMPORT_MONTHLY_LIMIT=10
